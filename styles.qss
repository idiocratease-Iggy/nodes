/* Global Dark Theme */
QWidget {
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Standard Buttons (Next, Back, Cancel) - Muted Slate Grey */
QPushButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #2d3748;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: normal;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #718096;
    border: 1px solid #a0aec0;
}

QPushButton:pressed {
    background-color: #2d3748;
}

/* Primary Action Button (Write Excel) - Sophisticated Deep Navy Gradient */
QPushButton#write_excel_btn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                     stop:0 #3182ce, stop:1 #2c5282);
    border: 1px solid #4299e1;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#write_excel_btn:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                     stop:0 #4299e1, stop:1 #3182ce);
}

/* SpinBox Styling - Fixes the "block blue" issue in EXE */
QAbstractSpinBox, QSpinBox, QDoubleSpinBox {
    background-color: #2d2d2d;
    border: 1px solid #404040;
    padding: 5px 24px 5px 5px;
    color: white;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 22px;
    subcontrol-origin: border;
}

QSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
}

QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 16px;
    height: 16px;
    color: white;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 16px;
    height: 16px;
    color: white;
}

/* RadioButton and CheckBox Styling - Unified Look */
QRadioButton {
    spacing: 6px;
    margin-bottom: 5px;
}


QCheckBox {
    spacing: 6px;
    margin-bottom: 5px;
}

QRadioButton::indicator, QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 2px solid #4a5568;
    border-radius: 7px;
    background-color: #1e1e1e;
}

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    border: 2px solid #718096;
    background-color: #3d4a5d;
}

/* Table styling */
QTableWidget {
    background-color: #2d2d2d;
    gridline-color: #404040;
    border: 1px solid #3c3c3c;
}

QHeaderView::section {
    background-color: #3c3c3c;
    padding: 4px;
    border: 1px solid #444444;
    color: #ffffff;
    font-weight: bold;
}

/* Input widgets */
QLineEdit, QCheckBox {
    padding: 5px;
    color: #ffffff;
}

/* Selection highlight */
QTableWidget::item:selected {
    background-color: #3e4a6b;
}

#title_label {
    font-weight: bold;
    font-size: 16px;
}
